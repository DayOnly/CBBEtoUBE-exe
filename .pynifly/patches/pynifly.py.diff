+class BSDecalPlacementVectorExtraData(NiExtraData):
+    buffer_type = PynBufferTypes.BSDecalPlacementVectorExtraDataBufType
+
+    def __init__(self, handle=None, file=None, id=NODEID_NONE, properties=None, parent=None):
