# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Editors
.vscode/
.idea/

# PyInstaller work cache (the SHIPPED exe lives in dist/ and IS tracked)
build/

# Generated data / runtime logs (not source)
output/
samples/
*.log

# Test scratch dirs (regenerated by the test suite)
tests/_tmp_*/

# reconvert scratch output (never committed)
_tmp_regen/
_tmp_regen*/

# Per-run failure record (written every run next to the run log)
CBBEtoUBE_last_failures.json

# Packaged release archives
CBBEtoUBE-*.zip

# LOCAL WORKING NOTES THAT NAME SPECIFIC MODS/ARMORS.
#
# The repo is public and tracked content is kept mod-agnostic. These files exist to
# record in-game findings, which is only useful if they say WHICH armour -- so they
# are local-only by design, not by accident.
#
# ARMOR_WORKLIST.md was already listed. The rest were merely UNTRACKED, which is not
# the same protection: `git add .` would have published them. CLIPPING_LOG.md alone
# carries 17 mod-naming lines. Found by the 2026-07-27 redundancy audit.
#
# Adding a new working note that names a mod? List it here in the same commit.
ARMOR_WORKLIST.md
CLIPPING_LOG.md
# Per-round in-game defect log. Every entry names the armour and its mod --
# that IS the point of it, and exactly why it cannot be published.
IN_GAME_BUGS.md
# The map from published synthetic names back to the REAL assets they stand in for.
# Local by definition: naming them is exactly what it is for.
LOCAL_ASSET_SAMPLES.md
AUDIT_REDUNDANCY_*.md
# Session working directories: measurement harnesses, A/B captures, pre-deploy
# binary backups and pre-reconvert manifests. They name real armours and mods
# and carry absolute local paths, so they are local by definition.
#
# IGNORED, not merely untracked. Being untracked is not protection -- one
# `git add -A` publishes the lot, and these have sat untracked next to a tracked
# tree for months relying on nobody typing it.
scratchpad_handoff_*/
CONVERTER_AUDIT_*.md
DESIGN_JIGGLE_PLAN.md
DESIGN_P5_*.md
DESIGN_P6_*.md

# Development measurement data (scripts/collect_fit_dataset.py).
# Generated artefacts, sometimes large; regenerate rather than commit.
fit_dataset*.jsonl
fit_census*.jsonl
# scripts/collect_penetration_census.py -- one row per ARMOR, keyed by its mesh path,
# so it names mods by construction.
penetration_census*.jsonl
multipose_census*.jsonl
source_delta_census*.jsonl
# scripts/underbust_census.py writes beside itself; same rule -- keyed by mesh path.
scripts/underbust_census*.json
*.census.jsonl

# Golden-output regression baseline (scripts/golden_output.py). Generated data, and
# its manifest records which MOD each source mesh came from -- so it falls under the
# same mod-agnostic rule as the working notes above. Re-capture rather than commit.
golden/

# Coverage-scan reports written into the repo root by a run. Both name the
# mods root AND list mod names, so they fall under the same mod-agnostic rule
# as the working notes above -- and nothing else stopped `git add .` staging
# them (found by the 2026-08-02 main audit).
ube_providers.txt
ube_replacers_to_disable.txt

# Per-user GUI state, written by the app beside the exe (frozen) or here
# (source). Tracking it means a source run dirties the working tree, and a
# clone would carry someone else's chosen flags. The app treats an absent
# file as "all defaults", so there is nothing to ship.
CBBEtoUBE_settings.json

# Outputs of the 2026-08-05 census scripts (scripts/analysis/). Same two rules
# as everything above, and both bite here:
#   * the JSON baselines are keyed by MESH PATH -- crumple_baseline.json alone
#     lists 365 hit pieces and 2504 clean ones, so it names mods by
#     construction;
#   * the A/B harnesses write whole CONVERTED NIF TREES (hundreds of MB) into
#     the repo root by default, and nothing else stopped `git add .` staging
#     them -- the same hole the 2026-08-02 audit found for the coverage reports.
# Override the scratch location with CBBE2UBE_AB_DIR if you want them elsewhere.
_ab_morphtri/
_ab_coherence/
crumple_baseline.json
morphtri_gated.json
census3_ab.json

# Golden capture sets from a same-build A/B (golden_off/, golden_on/, ...).
# Same generated data as golden/, just kept side by side for a comparison.
golden_*/
